minecraft-server() {
    if [[ "$1" == "open" ]]; then
        (cd ~/.Servers/My-Server && /usr/lib/jvm/java-21-openjdk/bin/java -Xmx4G -Xms4G -jar /home/n0tspec/.Servers/My-Server/paper-1.21.8-60.jar nogui)
        return
    fi

    if [[ "$1" == "--help" ]]; then
        (cd ~/.Servers/My-Server && cat "Command Help.txt")
        return
    fi

    echo "minecraft-server: wrong argument: $1, type minecraft-server --help for help"
}
