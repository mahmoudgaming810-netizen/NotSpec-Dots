ds4() {
    if [[ "$1" == "cnct" ]]; then
      ds4drv & disown
      return
    fi

    if [[ "$1" == "dscnct" ]]; then
      pkill ds4drv
      return
    fi

    echo "ds4: wrong argument: $1, type ds4 --help for help"
}
